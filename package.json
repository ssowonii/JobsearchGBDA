{
  "name": "internship-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Personal internship crawler + tracker with RAG search (marketing, content, UX/UI) for Ontario",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
