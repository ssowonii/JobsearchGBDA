# Copy to .env and fill in. Without a key, search falls back to keyword (BM25) matching.
OPENAI_API_KEY=sk-...

# Optional
# PORT=3000
# OPENAI_EMBED_MODEL=text-embedding-3-small
# Browser helper (npm run browser -- search): pipe-separated searches + location
# SEARCH_QUERIES=marketing intern|content creator intern|UX UI design intern
# SEARCH_LOCATION=Ontario, Canada
