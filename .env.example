# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres (added automatically when you connect Neon from the Vercel Marketplace).
# Use the pooled connection string. A Neon dev branch is handy for local work.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Semantic search + Match %. Without a key, search falls back to keyword matching.
OPENAI_API_KEY=sk-...

# Login. Leave APP_PASSWORD empty locally to skip the login screen (it is required on Vercel).
APP_PASSWORD=
# SESSION_SECRET signs login cookies: any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Bearer token for scripts (npm run browser) talking to the deployed hub.
HUB_TOKEN=
# Vercel Cron sends this to /api/cron/crawl (set it in Vercel; not needed locally).
CRON_SECRET=

# Optional
# OPENAI_EMBED_MODEL=text-embedding-3-small
# Browser helper: where captures go, and the searches it runs in search mode
# HUB_URL=https://your-app.vercel.app
# SEARCH_QUERIES=marketing intern|content creator intern|UX UI design intern
# SEARCH_LOCATION=Ontario, Canada
