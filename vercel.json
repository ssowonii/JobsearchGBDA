{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/**",
      "excludeFiles": "{node_modules/**,.next/**,tests/**,scripts/**,app/**,components/**,lib/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/crawl", "schedule": "0 11 * * *" }
  ]
}
